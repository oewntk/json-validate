{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/data"
    },
    {
      "$ref": "#/$defs/grouped_by_object_type"
    }
  ],
  "$defs": {
    "data": {
      "anyOf": [
        {
          "type": "object",
          "anyOf": [
            {
              "$ref": "defs-model.json#/$defs/lex"
            },
            {
              "$ref": "defs-model.json#/$defs/synset"
            },
            {
              "$ref": "defs-model.json#/$defs/sense"
            },
            {
              "$ref": "defs-model.json#/$defs/verbFrame"
            },
            {
              "$ref": "defs-model.json#/$defs/verbTemplate"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "defs-model.json#/$defs/lex"
              },
              {
                "$ref": "defs-model.json#/$defs/synset"
              },
              {
                "$ref": "defs-model.json#/$defs/sense"
              },
              {
                "$ref": "defs-model.json#/$defs/verbFrame"
              },
              {
                "$ref": "defs-model.json#/$defs/verbTemplate"
              }
            ]
          }
        }
      ]
    },
    "grouped_by_object_type": {
      "type": "object",
      "properties": {
        "lexes": {
          "type": "array",
          "items": {
            "$ref": "defs-model.json#/$defs/lex"
          }
        },
        "synsets": {
          "type": "array",
          "items": {
            "$ref": "defs-model.json#/$defs/synset"
          }
        },
        "senses": {
          "type": "array",
          "items": {
            "$ref": "defs-model.json#/$defs/sense"
          }
        },
        "verbFrames": {
          "type": "array",
          "items": {
            "$ref": "defs-model.json#/$defs/verbFrame"
          }
        },
        "verbTemplates": {
          "type": "array",
          "items": {
            "$ref": "defs-model.json#/$defs/verbTemplate"
          }
        }
      },
      "required": [
        "lexes",
        "synsets",
        "senses"
      ],
      "additionalProperties": false
    }
  }
}