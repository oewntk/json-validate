{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/flat"
    },
    {
      "type": "object",
      "properties": {
        "lexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lex"
          }
        },
        "synsets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/synset"
          }
        },
        "senses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sense"
          }
        },
        "verbFrames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verbFrame"
          }
        },
        "verbTemplates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verbTemplate"
          }
        }
      },
      "required": [
        "lexes",
        "synsets",
        "senses"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "flat": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/lex"
          },
          {
            "$ref": "#/$defs/synset"
          },
          {
            "$ref": "#/$defs/sense"
          },
          {
            "$ref": "#/$defs/verbFrame"
          },
          {
            "$ref": "#/$defs/verbTemplate"
          }
        ]
      }
    },
    "synsetId": {
      "type": "string",
      "pattern": "^\\d{8}-[nvars]$"
    },
    "lemma": {
      "type": "string",
      "pattern": "^[a-zA-Zñêòç0-9 \\-.+,!/':]+$"
    },
    "part-of-speech": {
      "type": "string",
      "enum": [
        "N",
        "V",
        "A",
        "R"
       ]
    },
    "synsetType": {
      "type": "string",
      "enum": [
        "N",
        "V",
        "A",
        "R",
        "S"
      ]
    },
    "discriminant": {
      "type": "string"
    },
    "lexId": {
      "type": "object",
      "properties": {
        "lemma": {
          "$ref": "#/$defs/lemma"
        },
        "type": {
          "$ref": "#/$defs/part-of-speech"
        },
        "discriminant": {
          "$ref": "#/$defs/discriminant"
        }
      },
      "required": [
        "lemma",
        "type"
      ],
      "additionalProperties": false
    },
    "senseKey": {
      "type": "string",
      "pattern": "^[a-zA-Zñêòç0-9 \\-.+,!/':_]+%\\d+:\\d+:\\d+:[a-z0-9_'/\\-.]*:\\d*$"
    },
    "synsetRelation": {
      "type": "string",
      "enum": [
        "also",
        "attribute",
        "causes",
        "domain_region",
        "domain_topic",
        "entails",
        "exemplifies",
        "has_domain_region",
        "has_domain_topic",
        "holo_member",
        "holo_part",
        "holo_substance",
        "hypernym",
        "hyponym",
        "instance_hypernym",
        "instance_hyponym",
        "is_caused_by",
        "is_entailed_by",
        "is_exemplified_by",
        "mero_member",
        "mero_part",
        "mero_substance",
        "other",
        "similar"
      ]
    },
    "senseRelation": {
      "type": "string",
      "enum": [
        "also",
        "antonym",
        "collocation",
        "derivation",
        "domain_region",
        "domain_topic",
        "exemplifies",
        "has_domain_region",
        "has_domain_topic",
        "is_exemplified_by",
        "other",
        "participle",
        "pertainym",
        "similar",

        "agent",
        "body_part",
        "by_means_of",
        "destination",
        "direction",
        "event",
        "instrument",
        "location",
        "material",
        "patient",
        "property",
        "result",
        "state",
        "undergoer",
        "uses",
        "vehicle"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "all",
        "pert",
        "ppl",
        "all",
        "act",
        "animal",
        "artifact",
        "attribute",
        "body",
        "cognition",
        "communication",
        "event",
        "feeling",
        "food",
        "group",
        "location",
        "motive",
        "object",
        "person",
        "phenomenon",
        "plant",
        "possession",
        "process",
        "quantity",
        "relation",
        "shape",
        "state",
        "substance",
        "time",
        "Tops",
        "body",
        "change",
        "cognition",
        "communication",
        "competition",
        "consumption",
        "contact",
        "creation",
        "emotion",
        "motion",
        "perception",
        "possession",
        "social",
        "stative",
        "weather"
      ]
    },
    "lexFile": {
      "type": "string",
      "enum": [
        "adj.all",
        "adj.pert",
        "adj.ppl",
        "adv.all",
        "noun.act",
        "noun.animal",
        "noun.artifact",
        "noun.attribute",
        "noun.body",
        "noun.cognition",
        "noun.communication",
        "noun.event",
        "noun.feeling",
        "noun.food",
        "noun.group",
        "noun.location",
        "noun.motive",
        "noun.object",
        "noun.person",
        "noun.phenomenon",
        "noun.plant",
        "noun.possession",
        "noun.process",
        "noun.quantity",
        "noun.relation",
        "noun.shape",
        "noun.state",
        "noun.substance",
        "noun.time",
        "noun.Tops",
        "verb.body",
        "verb.change",
        "verb.cognition",
        "verb.communication",
        "verb.competition",
        "verb.consumption",
        "verb.contact",
        "verb.creation",
        "verb.emotion",
        "verb.motion",
        "verb.perception",
        "verb.possession",
        "verb.social",
        "verb.stative",
        "verb.weather"
      ]
    },
    "adjPosition": {
      "type": "string",
      "enum": [
        "a",
        "p",
        "ip"
      ]
    },
    "tagCount": {
      "type": "integer",
      "minimum": 0
    },
    "wikidata": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "ili": {
      "type": "string",
      "pattern": "^(?:i\\d+|in)$",
      "description": "Interlingual Index id: 'i' followed by digits, or the literal 'in' (not-in-ILI marker)."
    },
    "lex": {
      "type": "object",
      "properties": {
        "lemma": {
          "$ref": "#/$defs/lemma"
        },
        "type": {
          "$ref": "#/$defs/part-of-speech"
        },
        "discriminant": {
          "$ref": "#/$defs/discriminant"
        },
        "senseKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/senseKey"
          }
        },
        "pronunciations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "variety": {
                "type": "string"
              }
            }
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "lemma",
        "type",
        "senseKeys"
      ],
      "additionalProperties": false
    },
    "synset": {
      "type": "object",
      "properties": {
        "synsetId": {
          "$ref": "#/$defs/synsetId"
        },
        "type": {
          "$ref": "#/$defs/synsetType"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lemma"
          }
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": ["text"]
          }
        },
        "usages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/synsetRelation"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/synsetId"
            }
          }
        },
        "ili": {
          "type": "string"
        },
        "wikidata": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "synsetId",
        "type",
        "domain",
        "members",
        "definitions"
      ],
      "additionalProperties": false
    },
    "sense": {
      "type": "object",
      "properties": {
        "senseId": {
          "$ref": "#/$defs/senseKey"
        },
        "lexId": {
          "$ref": "#/$defs/lexId"
        },
        "synsetId": {
          "type": "string"
        },
        "indexInLex": {
          "type": "number"
        },
        "relations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/senseRelation"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/senseKey"
            }
          }
        },
        "tagCount": {
          "type": "number"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "adjPosition": {
          "$ref": "#/$defs/adjPosition"
        },
        "verbFrames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verbTemplates": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "senseId",
        "lexId",
        "synsetId"
      ],
      "additionalProperties": false
    },
    "verbFrame": {
      "properties": {
        "id": {
          "type": "string"
        },
        "frame": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "frame"
      ],
      "additionalProperties": false
    },
    "verbTemplate": {
      "properties": {
        "id": {
          "type": "number"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "template"
      ],
      "additionalProperties": false
    }
  }
}