{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oewntk-tool/schema/wn-lmf-1.4-strict.json",
  "title": "WN-LMF LexicalResource",
  "description": "JSON Schema equivalent of schema1_4-strict.xsd (WordNet LMF 1.4, strict variant). XML attributes and child elements are both modeled as JSON object properties; repeatable child elements are pluralized as arrays (e.g. Sense+ -> 'senses'). Elements with mixed content (text + attributes) carry the text in a 'value' property.",
