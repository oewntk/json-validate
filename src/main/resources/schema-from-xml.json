  "properties": {
    "lexicons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Lexicon"
      }
    },
    "lexiconExtensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LexiconExtension"
      }
    }
  },
  "$defs": {
    "Word": {
      "type": "string",
      "pattern": "^[a-zA-Zñ0-9 \\-\\.,!/':]+$"
    },
    "ScriptType": {
      "type": "string",
      "pattern": "^[a-zA-Zñ0-9 \\-\\.,!/':]+$"
    },
    "LemmaType": {
      "type": "string",
      "pattern": "^[a-zA-Zñ0-9 \\-\\.,!/':_]+$"
    },
    "LexicalEntryIDType": {
      "type": "string",
      "pattern": "^oewn\\-[a-zA-Z0-9ñ_\\.\\-]*-[nvars](\\-[0-9])?$"
    },
    "SynsetIDType": {
      "type": "string",
      "pattern": "^oewn\\-\\d{8}\\-[nvars]$"
    },
    "SenseIDType": {
      "type": "string",
      "pattern": "^oewn\\-.*$"
    },
    "SyntacticBehaviourIDType": {
      "type": "string",
      "pattern": "^.*$"
    },
    "SynsetIDREFType": {
      "$ref": "#/$defs/SynsetIDType"
    },
    "LocalSynsetIDREFType": {
      "$ref": "#/$defs/SynsetIDType"
    },
    "SynsetIDREFSType": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SynsetIDType"
      },
      "minItems": 1
    },
    "LocalSynsetIDREFSType": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SynsetIDType"
      },
      "minItems": 1
