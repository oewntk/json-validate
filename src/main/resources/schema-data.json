{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/data",
  "$defs": {
    "data": {
      "anyOf": [
        {
          "type": "object",
          "anyOf": [
            {
              "$ref": "defs-data.json#/$defs/lex"
            },
            {
              "$ref": "defs-data.json#/$defs/synset"
            },
            {
              "$ref": "defs-data.json#/$defs/sense"
            },
            {
              "$ref": "defs-data.json#/$defs/verbFrame"
            },
            {
              "$ref": "defs-data.json#/$defs/verbTemplate"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "defs-data.json#/$defs/lex"
              },
              {
                "$ref": "defs-data.json#/$defs/synset"
              },
              {
                "$ref": "defs-data.json#/$defs/sense"
              },
              {
                "$ref": "defs-data.json#/$defs/verbFrame"
              },
              {
                "$ref": "defs-data.json#/$defs/verbTemplate"
              }
            ]
          }
        }
      ]
    }
  }
}