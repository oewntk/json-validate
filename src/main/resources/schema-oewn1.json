{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oewntk.githumb.io/schema/oewn1",
  "title": "oewn one format",
  "description": "oewn one format (lex embeds sense)",
  "$ref": "#/$defs/grouped_by_object_type",
  "$defs": {
    "grouped_by_key": {
      "type": "object",
      "patternProperties": {
        "^\\d{8}-[nvars]$": {
          "$ref": "defs-oewn.json#/$defs/synset"
        },
        "^(?!\\d{8}-[nvars]$)[a-zA-Z\\u00C0-\\u00D6\\u00D8-\\u00F60-9 \\-.+,!/':]+$": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[nvar](-[0-9]+)?$"
          },
          "additionalProperties": {
            "$ref": "defs-oewn.json#/$defs/lex"
          },
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "grouped_by_object_type": {
      "type": "object",
      "properties": {
        "lexes": {
          "$ref": "#/$defs/grouped_by_key"
        },
        "synsets": {
          "$ref": "#/$defs/grouped_by_key"
        }
      },
      "additionalProperties": false
    }
  }
}