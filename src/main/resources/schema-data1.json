{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/grouped_by_object_type",
  "$defs": {
    "grouped_by_object_type": {
      "type": "object",
      "properties": {
        "lexes": {
          "type": "array",
          "items": {
            "$ref": "defs-data.json#/$defs/lex"
          }
        },
        "synsets": {
          "type": "array",
          "items": {
            "$ref": "defs-data.json#/$defs/synset"
          }
        },
        "senses": {
          "type": "array",
          "items": {
            "$ref": "defs-data.json#/$defs/sense"
          }
        }
      },
      "required": [
        "lexes",
        "synsets",
        "senses"
      ],
      "additionalProperties": false
    }
  }
}